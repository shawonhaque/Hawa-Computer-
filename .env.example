# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hawa_computer?schema=public"

# Public site URL used for canonical links, sitemap and metadata
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Business contact details (also editable from Admin → Settings)
BUSINESS_PHONE="+8801711000000"
BUSINESS_WHATSAPP="+8801711000000"
BUSINESS_EMAIL="info@hawacomputer.com"

# Mobile money merchant numbers shown on the checkout/payment screens
BKASH_MERCHANT_NUMBER="01711000000"
NAGAD_MERCHANT_NUMBER="01711000000"
ROCKET_MERCHANT_NUMBER="017110000001"

# Uploads (payment screenshots, application documents)
UPLOAD_DIR="./storage/uploads"
MAX_UPLOAD_MB="5"

# Optional transactional email/SMS gateways (leave empty to log instead)
EMAIL_API_URL=""
EMAIL_API_KEY=""
EMAIL_FROM="no-reply@hawacomputer.com"
SMS_API_URL=""
SMS_API_KEY=""
